generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String
  price          Float
  oldPrice       Float?
  image          String
  gallery        String[]    @default([])
  isCustomizable Boolean     @default(false)
  label          String      @default("new")
  category       String
  inventoryCount Int         @default(0)
  reviews        Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  categoryLinks  ProductCategory[]
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  coverImage String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  productLinks ProductCategory[]

  @@unique([name])
  @@index([createdAt])
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Order {
  id                String      @id @default(cuid())
  displayId         String      @unique
  gokwikOrderId     String?
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  paidAmount        Float       @default(0)
  codBalance        Float       @default(0)
  paymentStatus     String      @default("pending")
  customerEmail     String
  customerPhone     String
  customerFirstName String
  customerLastName  String
  addressNickname   String      @default("Other")
  customerAddress   String
  customerCity      String
  customerState     String
  customerZip       String
  subtotal          Float
  shipping          Float
  total             Float
  status            OrderStatus @default(LIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
}

model PendingCheckout {
  id          String    @id
  data        Json
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  processedAt DateTime?

  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  priceAtPurchase Float
  customImageUrl String?
  customText     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model SavedAddress {
  id        String   @id @default(cuid())
  email     String
  nickname  String
  firstName String
  lastName  String
  phone     String
  address   String
  city      String
  state     String
  zip       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum OrderStatus {
  LIVE
  MANIFESTED
  SHIPPED
  DD
  DELIVER
  RTO
  CANCELLED
  SHIP_LATER
}
